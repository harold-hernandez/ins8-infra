# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored —
# never commit real project IDs' surrounding secrets here (there aren't any
# secrets in this file, but keep the habit).

project_id = "seedtech-staging"
region     = "us-east4"

# Must already be verified in Google Search Console under the identity
# running Terraform — see ../../README.md Prerequisites.
domain = "seedtech.dev"

# Leave these as the placeholder default until you've pushed a real image at
# least once (see ../../README.md for the bootstrap order).
# backend_image  = "us-east4-docker.pkg.dev/seedtech-staging/app/backend:latest"
# frontend_image = "us-east4-docker.pkg.dev/seedtech-staging/app/frontend:latest"
# migrate_image  = "us-east4-docker.pkg.dev/seedtech-staging/app/migrate:latest"

# Needed for CI to deploy via Workload Identity Federation instead of a
# stored service-account key — see modules/environment/ci.tf.
github_owner        = "harold-hernandez"
backend_repository  = "harold-hernandez/ins8-tasks"
frontend_repository = "harold-hernandez/ins8-frontend"
